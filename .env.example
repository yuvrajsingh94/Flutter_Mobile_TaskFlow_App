# TaskFlow Mobile Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# Development (Local LAN testing with phone):
# EXPO_PUBLIC_API_URL=http://<YOUR_PC_LAN_IP>:5000/api

# Staging:
# EXPO_PUBLIC_API_URL=https://staging-api.taskflow.com/api

# Production:
# EXPO_PUBLIC_API_URL=https://api.taskflow.com/api

EXPO_PUBLIC_API_URL=http://localhost:5000/api
